    {
      "id": 1,
      "type": "timeseries",
      "title": "Tasa de solicitudes por instancia (req/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "dg4zwh8a2kr28e"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dg4zwh8a2kr28e"
          },
          "editorMode": "code",
          "expr": "sum by (instance_id) (rate(backend_http_requests_total[30s]))",
          "legendFormat": "{{instance_id}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
